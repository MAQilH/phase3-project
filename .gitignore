.venv/
__pycache__/
*.pyc
.DS_Store

# Heavy generated binary caches (embeddings/indexes/query cache) — these are
# regenerated by build_index.py / retrieve.py and are scale-specific, so a
# stale committed copy silently shadows a fresh run's real output. Reports
# and outputs/ (JSON/CSV/markdown deliverables) are intentionally NOT
# ignored — they're small and are part of the graded submission.
artifacts/embeddings/*
!artifacts/embeddings/.keep
artifacts/index/*
!artifacts/index/.keep
artifacts/query_cache/*
!artifacts/query_cache/.keep

data/raw/
